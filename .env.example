# Email provider (Resend) — used by /api/contact and /api/enquiry
# Get a key at https://resend.com
RESEND_API_KEY=your_resend_api_key

# Address that receives contact/enquiry notifications
CONTACT_EMAIL=devbitindia@gmail.com

# Verified "from" address in your Resend account.
# Resend requires the domain in this address to be verified in your Resend
# account before it can send mail — see https://resend.com/domains.
# Until a custom domain is verified, Resend's shared onboarding address works
# for testing: "Devbit India <onboarding@resend.dev>"
CONTACT_FROM_EMAIL="Devbit India <onboarding@resend.dev>"
